# Copié depuis Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Doit correspondre EXACTEMENT à la redirect URI configurée dans Google Cloud
GOOGLE_REDIRECT_URI=https://youtube-mcp-server-tawny.vercel.app/api/oauth/callback

# Obtenu en visitant /api/oauth/start une seule fois (voir README)
YOUTUBE_REFRESH_TOKEN=

# Chaîne secrète que tu inventes toi-même (ex: openssl rand -hex 32)
# Sert à protéger l'accès à /api/mcp
MCP_AUTH_TOKEN=
